{
  "name": "dsh-wallpaper",
  "version": "0.1.0",
  "description": "DSH wallpaper plugin with independent wallpapers, crop, blur, surface opacity, appearance-aware text themes, fit and position controls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "MIT"
}
